---
import "../styles/global.css";
import PageMeta from "../components/shell/PageMeta.astro";
import SiteHeader from "../components/shell/SiteHeader.astro";
import { isNoindex } from "../lib/siteMode";

interface Props {
  title: string;
  description?: string;
  /**
   * Keep this page out of search indexes in every mode (the 404 page, the design-system preview).
   * Pages do not pass it for the prototype: src/lib/siteMode.ts keeps the whole site out of
   * indexes while the site is a prototype.
   */
  noindex?: boolean;
  /** Shared site header and navigation. On by default; set false only for non-site pages. */
  header?: boolean;
}

const { title, description, noindex = false, header = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PageMeta title={title} description={description} noindex={noindex} />
    {isNoindex(noindex) && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {/* Pages must provide <main id="main" tabindex="-1">. */}
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    {header && <SiteHeader />}
    <slot />
  </body>
</html>
