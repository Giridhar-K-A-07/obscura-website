---
import "../styles/global.css";
import SiteHeader from "../components/shell/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  /** Keep a page out of search indexes (e.g. the design-system preview). */
  noindex?: boolean;
  /** Shared site header and navigation. On by default; set false only for non-site pages. */
  header?: boolean;
}

const { title, description, noindex = false, header = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    {/* Pages must provide <main id="main" tabindex="-1">. */}
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    {header && <SiteHeader />}
    <slot />
  </body>
</html>
