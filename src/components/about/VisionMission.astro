---
import Section from "../home/Section.astro";

/*
  Vision and Mission, in the club's own words (Master Brief §4.1). Each is rendered only when
  its verified text exists, so one can appear without the other. The text is never reworded.
*/
interface Props {
  vision?: string | null;
  mission?: string | null;
}
const { vision, mission } = Astro.props;
---

{vision && (
  <Section id="vision" kicker="About" title="Vision">
    <p class="statement">{vision}</p>
  </Section>
)}
{mission && (
  <Section id="mission" kicker="About" title="Mission">
    <p class="statement">{mission}</p>
  </Section>
)}

<style>
  .statement {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.4;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-5);
  }
</style>
