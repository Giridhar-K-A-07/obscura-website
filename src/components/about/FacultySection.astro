---
import Section from "../home/Section.astro";
import type { FacultyMember } from "../../lib/aboutContent";

/*
  Faculty. `faculty` holds only verified people with recorded consent and a stated role
  (Master Brief §13.4). No name, role or department is written here.
*/
interface Props {
  faculty: FacultyMember[];
}
const { faculty } = Astro.props;
---

<Section id="faculty" kicker="About" title="Faculty">
  <ul class="people">
    {faculty.map((member) => (
      <li>
        <p class="name">{member.name}</p>
        <p class="type-meta">{member.role}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }
  .people li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .name {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
  }
</style>
