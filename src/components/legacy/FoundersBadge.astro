---
/*
  Founders' Badge (Master Brief P1.3): a distinct mark at the origin of the line. Rendered only
  for a term that a verified record marks as the founding term. It states only that term's
  verified academic year; it adds no founding story, date or names of its own.
*/
interface Props {
  academicYear: string;
}
const { academicYear } = Astro.props;
---

<div class="founders">
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1" />
    <circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="1" />
    <circle cx="24" cy="24" r="3" fill="currentColor" />
  </svg>
  <div>
    <p class="title">Founders' Badge</p>
    <p class="type-meta">The founding batch · {academicYear}</p>
  </div>
</div>

<style>
  .founders {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--accent);
    color: var(--text-accent);
  }
  .mark {
    flex: none;
    width: 3rem;
    height: 3rem;
  }
  .title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.2;
  }
  .founders .type-meta {
    color: var(--text-secondary);
  }
</style>
