---
import type { LegacyMember } from "../../lib/legacyContent";

/*
  One Executive Committee profile (Master Brief P1.2). Name and role always appear. Photo,
  LinkedIn and key contributions appear only when the member's verified record supplies them.
  Contributions sit in a native disclosure, so the list stays scannable and needs no JavaScript.
*/
interface Props {
  member: LegacyMember;
}
const { member } = Astro.props;
---

<div class="profile">
  {member.photo && (
    <img
      class="photo"
      src={member.photo}
      alt={`Photo of ${member.name}`}
      width="96"
      height="96"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="details">
    <p class="name">{member.name}</p>
    <p class="type-meta">{member.role}</p>
    {member.linkedin && (
      <p>
        <a class="link action" href={member.linkedin} rel="noopener noreferrer">
          {member.name} on LinkedIn
          <span class="type-meta"> (external site)</span>
        </a>
      </p>
    )}
    {member.contributions.length > 0 && (
      <details class="contributions">
        <summary>Key contributions</summary>
        <ul>
          {member.contributions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </details>
    )}
    {member.alsoServed.length > 0 && (
      <p class="type-meta">
        Also served:
        {member.alsoServed.map((term, index) => (
          <>
            {index > 0 ? ", " : " "}
            <a class="link action" href={term.href}>
              {term.academicYear}
            </a>
          </>
        ))}
      </p>
    )}
  </div>
</div>

<style>
  .profile {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    height: 100%;
  }
  .photo {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    /* Consistent monochrome portrait treatment across terms. */
    filter: grayscale(1) contrast(1.05);
  }
  .details {
    min-width: 0;
  }
  .details > * + * {
    margin-top: var(--space-2);
  }
  .name {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    font-weight: 600;
    line-height: 1.3;
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .action span {
    margin-left: var(--space-1); /* inline-flex drops the space before the label */
  }
  .action {
    flex-wrap: wrap; /* a long name keeps "(external site)" on its own line, not in a column */
  }
  .contributions summary {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    cursor: pointer;
    font-weight: 500;
  }
  .contributions ul {
    margin: 0;
    padding-left: var(--space-5);
  }
</style>
