---
import Section from "./Section.astro";

/* The club's own verified description (Master Brief §8.3). Rendered only when one exists. */
interface Props {
  description: string;
}
const { description } = Astro.props;
---

<Section id="introduction" kicker="What OBSCURA is" title="A club, brought into focus">
  <p class="statement">{description}</p>
  <p>
    <a class="link" href="/about">
      About OBSCURA
    </a>
  </p>
</Section>

<style>
  .statement {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    line-height: 1.3;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-5);
  }
</style>
