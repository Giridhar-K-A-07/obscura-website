---
import Section from "./Section.astro";
import type { HomeLearning } from "../../lib/homeContent";

/*
  Start learning (Master Brief §8.3). Rendered only when a roadmap is published.
  Only the official tracks that have a verified roadmap are listed; the others are not shown,
  so no roadmap is implied before its content is verified.
*/
interface Props {
  learning: HomeLearning;
}
const { learning } = Astro.props;
---

<Section id="learning" kicker="Resource & Learning Hub" title="Start learning">
  {learning.tracks.length > 0 && (
    <ul class="tracks">
      {learning.tracks.map((track) => (
        <li>
          <h3 class="type-h4">{track.label}</h3>
          <p class="type-meta">
            <a class="link" href={track.roadmap.href}>
              {track.roadmap.title}
            </a>
          </p>
        </li>
      ))}
    </ul>
  )}
  <p>
    <a class="btn" href="/learn">
      Resource & Learning Hub
    </a>
  </p>
</Section>

<style>
  .tracks {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-subtle);
  }
  .tracks a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .tracks li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  @media (min-width: 641px) {
    .tracks {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
</style>
