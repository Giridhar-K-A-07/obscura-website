---
import { loadFooterContent } from "../../lib/footerData";

/*
  Site footer. Contact and GitHub appear only when the verified site record has them (see
  src/lib/footerContent.ts); with none, only the always-present About and Privacy links remain.
  No placeholder is ever printed.
*/
const { email, github } = await loadFooterContent();
---

<footer class="footer">
  <div class="page grid">
    <div class="flow">
      <p class="mark">OBSCURA</p>
      {!email && !github && (
        <p class="type-meta measure">
          Prototype footer. Contact, social and legal details are not yet confirmed.
        </p>
      )}
    </div>
    <dl class="fields">
      {email && (
        <div>
          <dt class="type-label">Contact</dt>
          <dd>
            <a class="link" href={`mailto:${email}`}>
              {email}
            </a>
          </dd>
        </div>
      )}
      {github && (
        <div>
          <dt class="type-label">GitHub</dt>
          <dd>
            {github.href ? (
              <a class="link" href={github.href} rel="noopener noreferrer">
                {github.label}
              </a>
            ) : (
              github.label
            )}
          </dd>
        </div>
      )}
      <div>
        <dt class="type-label">About</dt>
        <dd>
          <a class="link" href="/about">
            About OBSCURA
          </a>
        </dd>
      </div>
      <div>
        <dt class="type-label">Privacy</dt>
        <dd>
          <a class="link" href="/privacy">
            Privacy page
          </a>
        </dd>
      </div>
    </dl>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-7);
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  .mark {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: 0.06em;
    font-size: var(--text-h3);
  }
  .fields {
    display: grid;
    gap: var(--space-4);
  }
  dd {
    margin: var(--space-1) 0 0;
  }
  @media (min-width: 641px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1025px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }
</style>
