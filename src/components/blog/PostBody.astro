---
/*
  The rendered article body (Markdown or MDX, already converted to HTML at build time).
  Reading-first: line length about 68ch, comfortable line height, generous spacing, headings in
  the site's serif. Code highlighting is done at build time by Shiki; its colours come from the
  existing design tokens through the variables below, so there is no new palette. Code blocks
  scroll sideways inside themselves (and are keyboard-focusable, see astro.config.mjs); tables
  and images never widen the page.
*/
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
    font-size: var(--text-body);
    line-height: 1.75;
    /* Shiki "css-variables" theme, mapped to the existing tokens. */
    --astro-code-foreground: var(--text-primary);
    --astro-code-background: var(--surface-raised);
    --astro-code-token-constant: var(--text-primary);
    --astro-code-token-string: var(--text-primary);
    --astro-code-token-comment: var(--text-secondary);
    --astro-code-token-keyword: var(--text-accent);
    --astro-code-token-parameter: var(--text-primary);
    --astro-code-token-function: var(--text-accent);
    --astro-code-token-string-expression: var(--text-primary);
    --astro-code-token-punctuation: var(--text-secondary);
    --astro-code-token-link: var(--text-accent);
  }
  .prose :global(> * + *) {
    margin-top: var(--space-4);
  }
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--space-6);
    scroll-margin-top: var(--space-6);
  }
  .prose :global(h2 + *),
  .prose :global(h3 + *),
  .prose :global(h4 + *) {
    margin-top: var(--space-3);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
    list-style: revert; /* the CSS reset removes list markers */
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--accent);
    color: var(--text-secondary);
  }
  .prose :global(a) {
    overflow-wrap: anywhere;
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .prose :global(hr) {
    margin-block: var(--space-6);
  }
  /* Code: block (Shiki output) and inline. */
  .prose :global(pre) {
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--text-small);
    line-height: 1.6;
    tab-size: 2;
  }
  .prose :global(pre code) {
    font-size: inherit;
    background: none;
    padding: 0;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    overflow-wrap: anywhere;
  }
  /* Tables scroll inside themselves, so a wide table never widens the page. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-small);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-subtle);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 600;
  }
</style>
