---
/*
  Page header: the one h1 and a sentence on what the blog is for (Master Brief P6). It describes
  the section only; it claims no article exists.
*/
---

<header class="intro">
  <div class="page-narrow flow">
    <p class="type-meta kicker">Blog</p>
    <h1 class="type-display">Tech Blog &amp; Insights</h1>
    <p class="type-lead measure">
      Student-written articles on data science trends, project breakdowns and event recaps.
    </p>
  </div>
</header>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-section);
  }
  .kicker {
    font-weight: 500;
  }
  .intro :global(.flow) {
    --flow-space: var(--space-4);
  }
</style>
