---
import Section from "../home/Section.astro";
import { formatDay, type SpotlightGroup } from "../../lib/achievementsContent";

/*
  Member Spotlights (Master Brief P3.2), grouped by category in the schema's order. `groups` holds
  only spotlights whose own consent and whose person's consent are recorded, so a name appears
  only with consent. Name, title, date and an optional verified link are all that is shown: no
  portrait, biography or detail is added.
*/
interface Props {
  groups: SpotlightGroup[];
}
const { groups } = Astro.props;
---

<Section id="spotlights" kicker="Achievements" title="Member Spotlights">
  {groups.map((group) => (
    <section class="group" aria-labelledby={`spotlights-${group.category}`}>
      <h3 class="type-h4" id={`spotlights-${group.category}`}>
        {group.label}
      </h3>
      <ul class="entries">
        {group.items.map((item) => (
          <li>
            <p class="who">{item.person}</p>
            <p>{item.title}</p>
            <p class="type-meta">
              <time datetime={item.date.toISOString().slice(0, 10)}>{formatDay(item.date)}</time>
            </p>
            {item.link && (
              <p>
                <a class="link action" href={item.link} rel="noopener noreferrer">
                  Read more: {item.title}
                  <span class="type-meta"> (external site)</span>
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Section>

<style>
  .group + .group {
    margin-top: var(--space-6);
  }
  .entries {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }
  .entries > li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .entries > li > * + * {
    margin-top: var(--space-2);
  }
  .who {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    font-weight: 600;
    line-height: 1.3;
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .action span {
    margin-left: var(--space-1); /* inline-flex drops the space before the label */
  }
</style>
