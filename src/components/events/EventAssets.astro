---
import type { PublicEvent } from "../../lib/eventsContent";

/*
  Verified photos, slides and repositories for one event. Each group renders only when it has
  items, so no empty label appears. Values were validated by the selector (site paths or https
  URLs only). Nothing here is a placeholder image: with no photo, there is no photo block.
*/
interface Props {
  event: PublicEvent;
}
const { event } = Astro.props;
const isExternal = (value: string) => value.startsWith("https://");
const repoLabel = (value: string) => {
  const url = new URL(value);
  return `${url.host}${url.pathname.replace(/\/$/, "")}`;
};
---

{event.photos.length > 0 && (
  <section id="photos" aria-labelledby="photos-title" class="group">
    <h2 class="type-h3" id="photos-title">
      {event.photos.length === 1 ? "Photo" : "Photos"}
    </h2>
    <ul class="photos">
      {event.photos.map((src, index) => (
        <li>
          <img
            src={src}
            alt={`Photo ${index + 1} of ${event.photos.length} from ${event.title}`}
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </section>
)}
{event.slides.length > 0 && (
  <section id="slides" aria-labelledby="slides-title" class="group">
    <h2 class="type-h3" id="slides-title">
      Slides
    </h2>
    <ul class="links">
      {event.slides.map((href, index) => (
        <li>
          <a
            class="link action"
            href={href}
            rel={isExternal(href) ? "noopener noreferrer" : undefined}
          >
            {event.slides.length === 1 ? "Slides" : `Slides ${index + 1}`}
            {isExternal(href) && <span class="type-meta"> (external site)</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
{event.repositories.length > 0 && (
  <section id="repositories" aria-labelledby="repositories-title" class="group">
    <h2 class="type-h3" id="repositories-title">
      {event.repositories.length === 1 ? "Code repository" : "Code repositories"}
    </h2>
    <ul class="links">
      {event.repositories.map((href) => (
        <li>
          <a class="link action" href={href} rel="noopener noreferrer">
            {repoLabel(href)}
            <span class="type-meta"> (external site)</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .group {
    scroll-margin-top: var(--space-6);
  }
  .group > * + * {
    margin-top: var(--space-3);
  }
  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
  }
  .photos img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
