---
import { describeWhen, type PublicEvent } from "../../lib/eventsContent";

/*
  Written date and time with the timezone, always together (Master Brief §8.4). Everything is
  shown in the event's own recorded timezone. An end is shown only when the record has one.
*/
interface Props {
  event: PublicEvent;
}
const { event } = Astro.props;
const when = describeWhen(event);
const start = when.startTime;
const end = when.endTime;
---

<p class="when">
  <time datetime={event.start.toISOString()}>
    {when.startDate}, {start}
  </time>
  {event.end && end && (
    <>
      {" "}
      to{" "}
      <time datetime={event.end.toISOString()}>
        {when.sameDay ? end : `${when.endDate}, ${end}`}
      </time>
    </>
  )}
  <span class="type-meta">
    {" "}
    ({when.timezone}, {when.offset})
  </span>
</p>
