---
/*
  Page header for the Learning Hub pages: the one h1 and a sentence on what the page is for
  (Master Brief P5). It describes the section only; it claims no roadmap or file exists.
*/
interface Props {
  kicker: string;
  title: string;
  lead: string;
}
const { kicker, title, lead } = Astro.props;
---

<header class="intro">
  <div class="page-narrow flow">
    <p class="type-meta kicker">{kicker}</p>
    <h1 class="type-display">{title}</h1>
    <p class="type-lead measure">{lead}</p>
  </div>
</header>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-section);
  }
  .kicker {
    font-weight: 500;
  }
  .intro :global(.flow) {
    --flow-space: var(--space-4);
  }
</style>
