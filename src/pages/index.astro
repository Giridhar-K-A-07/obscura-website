---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import IntroSection from "../components/home/IntroSection.astro";
import LearningTeaser from "../components/home/LearningTeaser.astro";
import LegacyTeaser from "../components/home/LegacyTeaser.astro";
import NextEvent from "../components/home/NextEvent.astro";
import PrototypeNotice from "../components/home/PrototypeNotice.astro";
import ProjectTeaser from "../components/home/ProjectTeaser.astro";
import RecentSection from "../components/home/RecentSection.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import { loadHomeContent } from "../lib/homeData";

/*
  Homepage. Composition follows Master Brief §8.3, in this order:
    Hero, Next event, What OBSCURA is, Legacy Line teaser, Recent, Built by members,
    Start learning, Footer.
  Empty-state rule (§8.3): a section with no real content is hidden entirely. Each section
  below renders only when `loadHomeContent` returns verified content for it (see
  src/lib/homeContent.ts). Nothing here is written by hand: there are no club facts in this file.
  The hero is always shown; the club's description appears in it only when verified.
  Still `noindex`: there is no verified launch content yet.
*/
const content = await loadHomeContent();
---

<BaseLayout
  title="OBSCURA — homepage prototype"
  description="Design prototype of the OBSCURA website. Not verified club content."
  noindex
>
  <PrototypeNotice />
  <main id="main" tabindex="-1">
    <Hero description={content.intro?.description} />
    {content.nextEvent && <NextEvent event={content.nextEvent} />}
    {content.intro && <IntroSection description={content.intro.description} />}
    {content.legacy && <LegacyTeaser legacy={content.legacy} />}
    {content.recent && <RecentSection recent={content.recent} />}
    {content.projects.length > 0 && <ProjectTeaser projects={content.projects} />}
    {content.learning && <LearningTeaser learning={content.learning} />}
  </main>
  <SiteFooter />
</BaseLayout>
