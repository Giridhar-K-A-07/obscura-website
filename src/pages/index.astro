---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Needed from "../components/home/Needed.astro";
import PrototypeNotice from "../components/home/PrototypeNotice.astro";
import ProjectCard from "../components/home/ProjectCard.astro";
import Section from "../components/home/Section.astro";
import SiteFooter from "../components/home/SiteFooter.astro";

/*
  Homepage prototype. Composition follows Master Brief §8.3.
  No club facts live here: every fact slot is a [[NEEDED: …]] placeholder.
  Brief §8.3 says a section with no real content is hidden in production. These sections are
  shown only because this is a design prototype; each must be driven by verified content
  records (and hidden when empty) before launch.
  All links are in-page anchors: the section pages (/legacy, /events, …) are not built yet.
*/
const tracks = ["Data Science", "Machine Learning", "Python", "SQL"];
---

<BaseLayout
  title="OBSCURA — homepage prototype"
  description="Design prototype of the OBSCURA website. Not verified club content."
  noindex
>
  <PrototypeNotice />
  <main id="main" tabindex="-1">
    <Hero />

    <Section id="introduction" kicker="What OBSCURA is" title="A club, brought into focus">
      <p class="statement">
        <Needed what="official 1–2 sentence description of OBSCURA" />
      </p>
      <p class="type-meta measure">
        This is the place for the club's own words: what it is and who it is for. Until the club
        provides and verifies them, none are shown.
      </p>
      <p>
        <a class="link" href="#introduction">
          About OBSCURA
        </a>
      </p>
    </Section>

    <Section id="legacy" kicker="The Legacy Line" title="Batch by batch, one line of history">
      <p class="measure">
        A scroll-driven timeline of the club, one entry per term, newest first. It begins at an
        origin marker and continues as new terms are added. A single term still reads as the start
        of a line.
      </p>
      <ol class="line" aria-label="Preview of how the Legacy Line will be laid out">
        <li class="stop">
          <h3 class="type-h4">Founders' Badge</h3>
          <p>
            <Needed what="founding batch, date and story — Master Brief §15" />
          </p>
        </li>
        <li class="stop">
          <h3 class="type-h4">
            <Needed what="term name" />
          </h3>
          <p>
            <Needed what="short summary of the term's milestones" />
          </p>
        </li>
        <li class="stop stop-open" aria-hidden="true">
          <span class="type-meta">The line continues as terms are added.</span>
        </li>
      </ol>
      <p>
        <a class="btn" href="#legacy">
          Explore the Legacy Line
        </a>
      </p>
    </Section>

    <Section id="events" kicker="Events & Initiatives Archive" title="Events">
      <p class="measure">
        Upcoming events come first, then the archive of past events. Each event shows only what
        exists: photos, recap, slides, repositories.
      </p>
      <h3 class="type-h4">Upcoming</h3>
      <dl class="row">
        <div>
          <dt class="type-label">Title</dt>
          <dd>
            <Needed what="event title" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Date and time</dt>
          <dd>
            <Needed what="date, time and timezone" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Type</dt>
          <dd>
            <Needed what="event type" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Venue</dt>
          <dd>
            <Needed what="venue" />
          </dd>
        </div>
      </dl>
      <h3 class="type-h4">Past</h3>
      <dl class="row">
        <div>
          <dt class="type-label">Title</dt>
          <dd>
            <Needed what="event title" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Date</dt>
          <dd>
            <Needed what="date" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Type</dt>
          <dd>
            <Needed what="event type" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Recap</dt>
          <dd>
            <Needed what="recap" />
          </dd>
        </div>
      </dl>
      <p>
        <a class="btn" href="#events">
          Events archive
        </a>
      </p>
    </Section>

    <Section id="achievements" kicker="Hall of Achievements & Wall of Fame" title="Achievements">
      <div class="pair">
        <div class="flow">
          <h3 class="type-h4">Competition Winners</h3>
          <p class="type-meta">Winners, project links and leaderboards.</p>
          <table class="board">
            <caption class="type-meta">Leaderboard layout preview</caption>
            <thead>
              <tr>
                <th scope="col">Rank</th>
                <th scope="col">Name</th>
                <th scope="col">Project</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="3">
                  <Needed what="competition results, only from verified records" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="flow">
          <h3 class="type-h4">Member Spotlights</h3>
          <p class="type-meta">
            Published research, top certifications and notable internships, featured only with the
            member's consent.
          </p>
          <p>
            <Needed what="member spotlights, with consent from each member" />
          </p>
        </div>
      </div>
      <p>
        <a class="btn" href="#achievements">
          Hall of Achievements
        </a>
      </p>
    </Section>

    <Section id="projects" kicker="Project Showcase & Portfolio" title="Built by members">
      <p class="measure">
        Open-source work by members, with links to the repository, live demo and dataset when they
        exist.
      </p>
      <ProjectCard>
        <Fragment slot="name">
          <Needed what="project name" />
        </Fragment>
        <Fragment slot="description">
          <Needed what="one-line project description" />
        </Fragment>
        <Fragment slot="contributors">
          <Needed what="contributors" />
        </Fragment>
      </ProjectCard>
      <p>
        <a class="btn" href="#projects">
          Project showcase
        </a>
      </p>
    </Section>

    <Section id="learning" kicker="Resource & Learning Hub" title="Start learning">
      <p class="measure">
        Curated study roadmaps for new members, plus downloadable guides, code templates and
        practice datasets.
      </p>
      <ul class="tracks-list">
        {tracks.map((track) => (
          <li>
            <h3 class="type-h4">{track}</h3>
            <p class="type-meta">
              <Needed what={`${track} roadmap — owner and last-reviewed date`} />
            </p>
          </li>
        ))}
      </ul>
      <p>
        <a class="btn" href="#learning">
          Resource & Learning Hub
        </a>
      </p>
    </Section>

    <Section id="insights" kicker="Tech Blog & Insights" title="Insights">
      <p class="measure">
        Student-written articles on data science trends, project breakdowns and event recaps.
      </p>
      <dl class="row">
        <div>
          <dt class="type-label">Title</dt>
          <dd>
            <Needed what="article title" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Author</dt>
          <dd>
            <Needed what="author, with their consent" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Date</dt>
          <dd>
            <Needed what="publication date" />
          </dd>
        </div>
        <div>
          <dt class="type-label">Reading time</dt>
          <dd>
            <Needed what="computed reading time" />
          </dd>
        </div>
      </dl>
      <p>
        <a class="btn" href="#insights">
          Read the blog
        </a>
      </p>
    </Section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="page-narrow flow">
        <h2 class="type-h1" id="closing-title">
          Step further into the chamber
        </h2>
        <p class="type-lead">
          Follow the Legacy Line, browse the archive, or begin a learning path.
        </p>
        <p class="actions">
          <a class="btn btn-primary" href="#legacy">
            The Legacy Line
          </a>
          <a class="btn" href="#learning">
            Start learning
          </a>
        </p>
        <p class="type-meta">
          <Needed what="how to join or get in touch — Master Brief §15" />
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .statement {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    line-height: 1.3;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-5);
  }
  /* Legacy line teaser */
  .line {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0 0 0 var(--space-6);
    position: relative;
  }
  .line::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--border-ui), transparent);
  }
  .stop {
    position: relative;
    padding-bottom: var(--space-6);
  }
  .stop::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--space-6));
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--surface-page);
    border: 2px solid var(--accent);
  }
  .stop-open::before {
    border-style: dashed;
    border-color: var(--border-ui);
  }
  /* Field rows for event / article previews: lists, not cards. */
  .row {
    display: grid;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
    border-block: 1px solid var(--border-subtle);
    margin: 0;
  }
  .row dd {
    margin: var(--space-1) 0 0;
  }
  .pair {
    display: grid;
    gap: var(--space-6);
  }
  .board {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
  }
  .board caption {
    text-align: left;
    padding-bottom: var(--space-2);
  }
  .board th,
  .board td {
    text-align: left;
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }
  .board th {
    font-weight: 600;
  }
  .tracks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border-subtle);
  }
  .tracks-list li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .closing {
    border-top: 1px solid var(--border-subtle);
    padding-block: calc(var(--space-section) * 1.25);
    background: radial-gradient(ellipse at 50% 0%, rgb(188 205 255 / 0.07), transparent 60%);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (min-width: 641px) {
    .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
    .tracks-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
  @media (min-width: 1025px) {
    .row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
