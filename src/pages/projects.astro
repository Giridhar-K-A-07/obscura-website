---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectsIntro from "../components/projects/ProjectsIntro.astro";
import ProjectsList from "../components/projects/ProjectsList.astro";
import PrototypeNotice from "../components/home/PrototypeNotice.astro";
import SiteFooter from "../components/home/SiteFooter.astro";
import { loadProjects } from "../lib/projectsData";

/*
  Project Showcase & Portfolio (Master Brief P4, §8.4). The list renders only when there are
  verified projects (src/lib/projectsContent.ts); with none, the page is its introduction. There
  are no club facts in this file. Per-project pages (/projects/[slug]) are optional in the brief
  and are not built: cards link straight out. Still `noindex`: there is no verified launch
  content yet.
*/
const projects = await loadProjects();
---

<BaseLayout
  title="Project Showcase & Portfolio — OBSCURA"
  description="Project Showcase & Portfolio. Design prototype; not verified club content."
>
  <PrototypeNotice />
  <main id="main" tabindex="-1">
    <ProjectsIntro />
    {projects.length > 0 && <ProjectsList projects={projects} />}
  </main>
  <SiteFooter />
</BaseLayout>
