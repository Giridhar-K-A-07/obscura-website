---
import HeroCanvas from "../components/home/HeroCanvas";
import { eventPath } from "../lib/eventsContent";
import { eventDateParts } from "./designLab";
import type { FooterContent } from "../lib/footerContent";
import { areaNodes, tracksOf } from "../lib/homeGraph";
import { formatDay, formatEventDate, type HomeContent } from "../lib/homeContent";
import { siteMode } from "../lib/siteMode";

/*
  CONCEPT A: Editorial chamber (design exploration, not selected or approved).
  A publication read in a dark room. Foundation F1 navy-black, type pairing T1 (serif display),
  accent A1 only (docs/design-direction.md). The hero reuses the production network canvas island
  unchanged, framed as a figure with a caption. Sections follow Master Brief §8.3 in order and are
  hidden when empty; every value comes from the content the real homepage uses.
*/
interface Props {
  content: HomeContent;
  footer: FooterContent;
}
const { content, footer } = Astro.props;
const { intro, nextEvent, legacy, recent, projects, learning } = content;
const [lead, ...others] = projects;
const when = nextEvent ? eventDateParts(nextEvent.start, nextEvent.timezone) : null;
const stops = legacy
  ? [
      ...(legacy.founding ? [{ label: "Founding term", term: legacy.founding }] : []),
      { label: "Latest term", term: legacy.latest },
    ]
  : [];
---

<main id="main" tabindex="-1" data-concept="a">
  <section class="hero" aria-labelledby="hero-title" id="top">
    <div class="wrap hero-grid">
      <div class="copy">
        <h1 id="hero-title" class="wordmark">
          OBSCURA
        </h1>
        <p class="tagline">Unveiling the unknown</p>
        {intro && <p class="lead">{intro.description}</p>}
        <p class="actions">
          <a class="btn btn-primary" href="/about">
            Explore OBSCURA
          </a>
          <a class="btn" href="/legacy">
            The Legacy Line
          </a>
        </p>
        <nav aria-label="Explore OBSCURA" class="explore">
          <p class="type-label">Explore</p>
          <ul>
            {areaNodes.map((area) => (
              <li>
                <a class="link-quiet" href={area.href} data-node-link={area.id}>
                  {area.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="type-label">Study roadmap tracks</p>
          <ul class="tracks">
            {tracksOf("learning").map((track) => (
              <li>
                <a class="link-quiet" href={track.href} data-node-link={track.id}>
                  {track.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <figure class="plate reveal">
        <HeroCanvas client:idle />
        <figcaption class="type-meta">
          Figure. The areas of this site, drawn as a network. Point at, or tap, a point to bring it
          into focus.
        </figcaption>
      </figure>
    </div>
  </section>

  {nextEvent && when && (
    <section class="band event" aria-labelledby="next-event-title" id="next-event">
      <div class="wrap grid">
        <div class="date" aria-hidden="true">
          <span class="day">{when.day}</span>
          <span class="month">
            {when.month} {when.year}
          </span>
        </div>
        <div class="body">
          <p class="kicker">Next event</p>
          <h2 id="next-event-title" class="display-h2">
            {nextEvent.title}
          </h2>
          <dl class="facts">
            <div>
              <dt>Date and time</dt>
              <dd>
                <time datetime={nextEvent.start.toISOString()}>
                  {formatEventDate(nextEvent.start, nextEvent.timezone)}
                </time>
              </dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{nextEvent.type}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{nextEvent.venue}</dd>
            </div>
          </dl>
          <p class="actions">
            <a class="btn btn-primary" href={eventPath(nextEvent.id)}>
              Event details
            </a>
            <a class="btn" href="/events">
              All events
            </a>
          </p>
        </div>
      </div>
    </section>
  )}

  {intro && (
    <section class="band intro" aria-labelledby="introduction-title" id="introduction">
      <div class="wrap">
        <p class="kicker">What OBSCURA is</p>
        <h2 id="introduction-title" class="visually-quiet">
          A club, brought into focus
        </h2>
        <p class="statement">{intro.description}</p>
        <p>
          <a class="link action" href="/about">
            About OBSCURA
          </a>
        </p>
      </div>
    </section>
  )}

  {legacy && (
    <section class="band legacy" aria-labelledby="legacy-title" id="legacy">
      <div class="wrap">
        <p class="kicker">The Legacy Line</p>
        <h2 id="legacy-title" class="display-h2 narrow">
          Batch by batch, one line of history
        </h2>
        <ol class="line">
          {stops.map(({ label, term }) => (
            <li class="stop">
              <p class="type-meta">
                {label} · {term.academicYear}
              </p>
              <h3 class="stop-name">{term.name}</h3>
              {term.summary && <p class="stop-text">{term.summary}</p>}
            </li>
          ))}
        </ol>
        <p>
          <a class="btn" href="/legacy">
            Explore the Legacy Line
          </a>
        </p>
      </div>
    </section>
  )}

  {recent && (
    <section class="band recent" aria-labelledby="recent-title" id="recent">
      <div class="wrap">
        <p class="kicker">Recent</p>
        <h2 id="recent-title" class="display-h2 narrow">
          Lately in the chamber
        </h2>
        <ul class="entries">
          {recent.event && (
            <li>
              <p class="type-meta">Past event · {formatDay(recent.event.start)}</p>
              <h3 class="entry-title">{recent.event.title}</h3>
              <p>
                <a class="link action" href={eventPath(recent.event.id)}>
                  Event details
                </a>
              </p>
            </li>
          )}
          {recent.post && (
            <li>
              <p class="type-meta">Article · {formatDay(recent.post.date)}</p>
              <h3 class="entry-title">{recent.post.title}</h3>
              <p>
                <a class="link action" href="/blog">
                  Read the blog
                </a>
              </p>
            </li>
          )}
        </ul>
      </div>
    </section>
  )}

  {lead && (
    <section class="band projects" aria-labelledby="projects-title" id="projects">
      <div class="wrap">
        <p class="kicker">Project Showcase &amp; Portfolio</p>
        <h2 id="projects-title" class="display-h2 narrow">
          Built by members
        </h2>
        <div class="project-grid">
          <article class="lead-project">
            <h3 class="lead-name">{lead.name}</h3>
            <p class="lead-text">{lead.description}</p>
            {lead.topics.length > 0 && (
              <ul class="topics" aria-label="Topics">
                {lead.topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            )}
            {lead.contributors.length > 0 && (
              <p class="type-meta">Contributors: {lead.contributors.join(", ")}</p>
            )}
            <p class="links">
              <a class="link action" href={lead.repository}>
                {lead.name} repository
              </a>
              {lead.liveDemo && (
                <a class="link action" href={lead.liveDemo}>
                  {lead.name} live demo
                </a>
              )}
            </p>
          </article>
          {others.length > 0 && (
            <ul class="more">
              {others.map((project) => (
                <li>
                  <h3 class="more-name">{project.name}</h3>
                  <p class="type-meta">{project.description}</p>
                  <p>
                    <a class="link action" href={project.repository}>
                      {project.name} repository
                    </a>
                  </p>
                </li>
              ))}
            </ul>
          )}
        </div>
        <p>
          <a class="btn" href="/projects">
            Project showcase
          </a>
        </p>
      </div>
    </section>
  )}

  {learning && (
    <section class="band learning" aria-labelledby="learning-title" id="learning">
      <div class="wrap">
        <p class="kicker">Resource &amp; Learning Hub</p>
        <h2 id="learning-title" class="display-h2 narrow">
          Start learning
        </h2>
        {learning.tracks.length > 0 && (
          <ol class="tracks-list">
            {learning.tracks.map((track) => (
              <li>
                <a class="track" href={track.roadmap.href}>
                  <span class="track-name">{track.label}</span>
                  <span class="track-road">{track.roadmap.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
        <p>
          <a class="btn" href="/learn">
            Resource &amp; Learning Hub
          </a>
        </p>
      </div>
    </section>
  )}
</main>

<footer class="a-footer" data-concept="a">
  <div class="wrap foot">
    <div>
      <p class="foot-mark">OBSCURA</p>
      {siteMode.prototype && !footer.email && !footer.github && (
        <p class="type-meta measure">
          Prototype footer. Contact, social and legal details are not yet confirmed.
        </p>
      )}
    </div>
    <dl class="fields">
      {footer.email && (
        <div>
          <dt>Contact</dt>
          <dd>
            <a class="link" href={`mailto:${footer.email}`}>
              {footer.email}
            </a>
          </dd>
        </div>
      )}
      {footer.github && (
        <div>
          <dt>GitHub</dt>
          <dd>
            {footer.github.href ? (
              <a class="link" href={footer.github.href} rel="noopener noreferrer">
                {footer.github.label}
              </a>
            ) : (
              footer.github.label
            )}
          </dd>
        </div>
      )}
      <div>
        <dt>About</dt>
        <dd>
          <a class="link" href="/about">
            About OBSCURA
          </a>
        </dd>
      </div>
      <div>
        <dt>Privacy</dt>
        <dd>
          <a class="link" href="/privacy">
            Privacy page
          </a>
        </dd>
      </div>
    </dl>
  </div>
</footer>

<style is:global>
  /* Concept A overrides the shared header and the type tokens for this page only. */
  html:has(main[data-concept="a"]) {
    --font-serif: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
  }
  html:has(main[data-concept="a"]) .site-header {
    border-bottom-color: rgb(52 70 92 / 0.6);
  }
  html:has(main[data-concept="a"]) .site-header .brand {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.22em;
  }
  html:has(main[data-concept="a"]) .site-header .link-quiet {
    color: var(--text-secondary);
    letter-spacing: 0.01em;
  }
  html:has(main[data-concept="a"]) .site-header .link-quiet:hover {
    color: var(--text-primary);
  }
  html:has(main[data-concept="a"]) .site-header .link-quiet[aria-current="page"] {
    color: var(--text-accent);
  }
</style>

<style>
  .wrap {
    --a-max: 80rem;
    width: min(100% - 2 * var(--gutter), var(--a-max));
    margin-inline: auto;
  }
  .kicker {
    font-size: var(--text-small);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-3);
  }

  /* ---- Hero ----------------------------------------------------------------------------- */
  .hero {
    position: relative;
    overflow-x: clip;
    padding-block: var(--space-8) var(--space-9);
    /* The one soft gradient on screen: a diffuse pool of projected light behind the plate. */
    background: radial-gradient(55% 60% at 74% 38%, rgb(188 205 255 / 0.09), rgb(8 11 18 / 0) 70%);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-7);
  }
  .copy > * + * {
    margin-top: var(--space-5);
  }
  .wordmark {
    font-size: clamp(3.25rem, 16vw, 8rem);
    white-space: nowrap;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 0.95;
    margin-left: -0.04em;
  }
  .tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-h2);
    color: var(--text-accent);
  }
  .lead {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    line-height: 1.55;
    max-width: 34ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .explore {
    border-top: 1px solid rgb(52 70 92 / 0.7);
    padding-top: var(--space-4);
    margin-top: var(--space-6);
  }
  .explore ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .explore .type-label:not(:first-child) {
    margin-top: var(--space-3);
  }
  .explore :global(.link-quiet) {
    min-width: var(--target-min);
  }
  .tracks :global(.link-quiet) {
    color: var(--text-secondary);
  }
  .plate {
    margin: 0;
    min-width: 0;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border: 1px solid rgb(52 70 92 / 0.8);
    background: linear-gradient(rgb(17 24 38 / 0.55), rgb(8 11 18 / 0.2));
    position: relative;
  }
  .plate figcaption {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(52 70 92 / 0.6);
    max-width: 48ch;
  }
  /* The production island puts its pause control at the bottom left of the figure. */
  .plate :global(.hero-canvas) {
    padding-bottom: var(--space-7);
  }

  /* ---- Section bands: a horizon rule with an aperture mark between sections ---------------- */
  .band {
    position: relative;
    padding-block: clamp(4rem, 2rem + 8vw, 9rem);
  }
  .band::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(107 119 136 / 0.55) 20%,
      rgb(107 119 136 / 0.55) 80%,
      transparent
    );
  }
  .band::after {
    content: "";
    position: absolute;
    top: -5px;
    left: max(var(--gutter), calc((100% - var(--a-max)) / 2));
    width: 11px;
    height: 11px;
    border: 1px solid rgb(154 165 180 / 0.8);
    border-radius: var(--radius-full);
    background: var(--surface-page);
  }
  .display-h2 {
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.75rem);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .narrow {
    max-width: 18ch;
  }
  .visually-quiet {
    font-size: var(--text-h3);
    font-style: italic;
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  /* ---- Next event: the date as a typographic object ----------------------------------------- */
  .event {
    background: linear-gradient(rgb(17 24 38 / 0.5), transparent);
  }
  .grid {
    display: grid;
    gap: var(--space-6);
  }
  .date {
    font-family: var(--font-serif);
    line-height: 0.85;
  }
  .day {
    display: block;
    font-size: clamp(6rem, 3rem + 14vw, 13rem);
    font-weight: 400;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }
  .month {
    display: block;
    margin-top: var(--space-3);
    font-size: var(--text-h2);
    font-style: italic;
    color: var(--text-secondary);
  }
  .facts {
    display: grid;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
    padding-block: var(--space-5);
    border-block: 1px solid rgb(52 70 92 / 0.8);
  }
  .facts dt {
    font-size: var(--text-small);
    color: var(--text-secondary);
  }
  .facts dd {
    margin: var(--space-1) 0 0;
  }

  /* ---- Introduction: pure type ---------------------------------------------------------------- */
  .intro .wrap {
    max-width: 62rem;
  }
  .statement {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.1rem + 2.7vw, 3.4rem);
    line-height: 1.22;
    letter-spacing: -0.005em;
    padding-top: var(--space-5);
    border-top: 2px solid var(--accent);
    max-width: 22em;
    margin-bottom: var(--space-6);
  }

  /* ---- Legacy: a line that continues ---------------------------------------------------------- */
  .line {
    list-style: none;
    margin: var(--space-7) 0;
    padding: 0 0 0 var(--space-6);
    position: relative;
  }
  .line::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: -2rem;
    width: 1px;
    background: linear-gradient(var(--border-ui), transparent);
  }
  .stop {
    position: relative;
    padding-bottom: var(--space-7);
  }
  .stop::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--space-6));
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--surface-page);
    border: 2px solid var(--accent);
  }
  .stop-name {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    margin-block: var(--space-2);
  }
  .stop-text {
    max-width: 44ch;
    color: var(--text-secondary);
  }

  /* ---- Recent: two entries set like a contents page ------------------------------------------- */
  .entries {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid rgb(52 70 92 / 0.8);
  }
  .entries li {
    padding-block: var(--space-6);
    border-bottom: 1px solid rgb(52 70 92 / 0.8);
  }
  .entry-title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    margin-block: var(--space-2) var(--space-3);
    max-width: 24ch;
  }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  /* ---- Projects: a lead entry and a short list, no cards ------------------------------------- */
  .project-grid {
    display: grid;
    gap: var(--space-7);
    margin-block: var(--space-7);
  }
  .lead-project > * + * {
    margin-top: var(--space-4);
  }
  .lead-name {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 500;
    line-height: 1.08;
  }
  .lead-text {
    font-size: var(--text-lead);
    max-width: 40ch;
  }
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-small);
  }
  .topics li + li::before {
    content: "·";
    margin-right: var(--space-4);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .more {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(52 70 92 / 0.8);
  }
  .more li {
    padding-block: var(--space-5);
    border-bottom: 1px solid rgb(52 70 92 / 0.8);
  }
  .more-name {
    font-size: var(--text-h3);
    font-weight: 500;
    margin-bottom: var(--space-1);
  }

  /* ---- Learning: the roadmaps are a real sequence, so they are numbered -------------------------- */
  .tracks-list {
    list-style: none;
    counter-reset: track;
    margin: var(--space-7) 0;
    padding: 0;
    border-top: 1px solid rgb(52 70 92 / 0.8);
  }
  .tracks-list li {
    counter-increment: track;
    border-bottom: 1px solid rgb(52 70 92 / 0.8);
  }
  .track {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    column-gap: var(--space-4);
    padding-block: var(--space-5);
    min-height: var(--target-min);
    color: var(--text-primary);
    text-decoration: none;
    transition: padding-left var(--duration-feedback) var(--ease-out);
  }
  .track::before {
    content: counter(track);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    font-size: var(--text-h3);
    grid-row: 1 / span 2;
  }
  .track-name {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .track-road {
    grid-column: 2;
    color: var(--text-secondary);
    font-size: var(--text-small);
    margin-top: var(--space-1);
  }
  .track:hover,
  .track:focus-visible {
    padding-left: var(--space-3);
  }
  .track:hover .track-name,
  .track:focus-visible .track-name {
    color: var(--text-accent);
  }

  /* ---- Footer -------------------------------------------------------------------------------- */
  .a-footer {
    border-top: 1px solid rgb(52 70 92 / 0.8);
    padding-block: var(--space-8);
    background: linear-gradient(transparent, rgb(17 24 38 / 0.5));
  }
  .foot {
    display: grid;
    gap: var(--space-6);
  }
  .foot-mark {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    letter-spacing: 0.1em;
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .fields {
    display: grid;
    gap: var(--space-4);
  }
  .fields dt {
    font-size: var(--text-small);
    color: var(--text-secondary);
  }
  .fields dd {
    margin: var(--space-1) 0 0;
  }
  .fields a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  /* ---- Scroll reveal for legacy entries (the signature reveal; CSS only; skipped for reduced motion) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stop {
        animation-name: a-reveal;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% entry 70%;
      }
    }
  }
  @keyframes a-reveal {
    from {
      opacity: 0.8;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      filter: none;
    }
  }

  /* ---- Layout from tablet up ------------------------------------------------------------------ */
  @media (min-width: 641px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .entries {
